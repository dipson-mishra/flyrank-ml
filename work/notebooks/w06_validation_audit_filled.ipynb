    "# W06 — Validation & Signal Audit (filled)\n",
    "\n",
    "This notebook runs quick, honest checks against the starter CSV. It computes label rates, an honest (grouped) split, and a small leakage probe. Fill interpretation cells with prose before submitting."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "p = Path('data/raw/content_refresh_anonymized.csv')\n",
    "assert p.exists(), 'starter CSV missing'\n",
    "df = pd.read_csv(p)\n",
    "print('rows,cols:', df.shape)\n",
    "# Basic head and label construction\n",
    "df['is_declining_label'] = df['trend_direction'].fillna('').str.lower() == 'down'\n",
    "print('label counts:\n', df['is_declining_label'].value_counts(dropna=False))\n",
    "# Save a small probe\n",
    "df.head(3)
"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Honest grouped split (client-level) — show base rates before/after"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.model_selection import GroupShuffleSplit\n",
    "import numpy as np\n",
    "gss = GroupShuffleSplit(n_splits=1, test_size=0.2, random_state=42)\n",
    "groups = df['client_id']\n",
    "train_ix, test_ix = next(gss.split(df, groups=groups))\n",
    "print('train rows, test rows:', len(train_ix), len(test_ix))\n",
    "print('train label rate:', df.loc[train_ix, 'is_declining_label'].mean())\n",
    "print('test label rate:', df.loc[test_ix, 'is_declining_label'].mean())\n",
    "# Basic sense check: per-client rates (show a few)
",
    "per_client = df.groupby('client_id')['is_declining_label'].agg(['mean','count']).rename(columns={'mean':'rate','count':'n'})\n",
    "per_client.sort_values('n', ascending=False).head()
"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Leakage audit (simple probes)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3a: Features that leak the label by construction: names containing 'trend' usually are not valid features\n",
    "leaky = [c for c in df.columns if 'trend' in c.lower()]\n",
    "print('columns containing trend:', leaky)\n",
    "# 3b: Correlation probe (numerical columns only)\n",
    "num = df.select_dtypes(include=['number']).copy()\n",
    "if 'is_declining_label' in num.columns:\n",
    "    num = num.drop(columns=['is_declining_label'])\n",
    "corrs = num.corrwith(df['is_declining_label']).abs().sort_values(ascending=False)\n",
    "print('Top numeric correlations with label (abs):')\n",
    "print(corrs.head(10))\n",
    "# 3c: Sample-size floor example for a bucketed test\n",
    "bucket = df.groupby('age_tier')['is_declining_label'].agg(['mean','count']).rename(columns={'mean':'rate'})\n",
    "print('age_tier rates (showing n):')\n",
    "print(bucket.sort_values('count', ascending=False))
"
   ]
  },
